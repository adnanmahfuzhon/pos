generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
}

model Ingredient {
  id           String              @id @default(uuid())
  code         String
  name         String
  type         String
  unit         String
  pricePerUnit Float
  stock        Float
  minStock     Float
  priceHistory Json?
  recipe       Json?
  branchId     String
  branch       Branch              @relation(fields: [branchId], references: [id])
  products     ProductIngredient[]
}

model Product {
  id            String              @id @default(uuid())
  name          String
  price         Float
  category      String
  isActive      Boolean
  imageUrl      String?
  channelPrices Json                @default("{}")
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  ingredients   ProductIngredient[]
}

model ProductIngredient {
  id           String     @id @default(uuid())
  productId    String
  ingredientId String
  quantity     Float
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
}

model Sale {
  id            String       @id @default(uuid())
  timestamp     Float
  totalAmount   Float
  totalHPP      Float
  paymentMethod String
  channel       String
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  details       SaleDetail[]
}

model SaleDetail {
  id          String @id @default(uuid())
  saleId      String
  productId   String
  quantity    Float
  priceAtSale Float
  hppAtSale   Float
  sale        Sale   @relation(fields: [saleId], references: [id])
}

model Expense {
  id                 String  @id @default(uuid())
  timestamp          Float
  category           String
  itemName           String
  amount             Float
  linkedIngredientId String?
  quantity           Float?
  branchId           String
  branch             Branch  @relation(fields: [branchId], references: [id])
}

model Income {
  id         String @id @default(uuid())
  timestamp  Float
  category   String
  sourceName String
  amount     Float
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])
}

model Branch {
  id          String       @id @default(uuid())
  name        String       @unique
  expenses    Expense[]
  incomes     Income[]
  ingredients Ingredient[]
  products    Product[]
  sales       Sale[]
  users       User[]
}

enum Role {
  SUPER_ADMIN
  MANAGER
  STAFF
}
